<ui:FluentWindow x:Class="Kwatermistrz.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:Kwatermistrz.App.Controls"
                 xmlns:vm="clr-namespace:Kwatermistrz.App.ViewModels"
                 Title="Kwatermistrz" Height="800" Width="1280"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 WindowBackdropType="Mica">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NawigujCommand}" CommandParameter="Wyprawa" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FokusujSzukanieCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Pasek górny: wyszukiwanie, przełącznik rekonstrukcji, "Dodaj wyprawę" (FR-103, §10.4) -->
        <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" x:Name="PoleSzukania"
                            PlaceholderText="Szukaj… (Ctrl+F)"
                            Text="{Binding SzukajTekst, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Symbol=Search24}" />
                <ComboBox Grid.Column="1" MinWidth="180" Margin="12,0,0,0"
                          ItemsSource="{Binding RekonstrukcjeLista}"
                          SelectedValue="{Binding AktywnaRekonstrukcjaId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Nazwa"
                          ToolTip="Aktywna rekonstrukcja — filtruje wszystko (FR-1303)" />
                <ui:Button Grid.Column="2" Margin="12,0,0,0" Appearance="Primary"
                           Command="{Binding DodajWypraweCommand}"
                           ToolTip="Dodaj wyprawę (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" />
                        <TextBlock Text="Dodaj wyprawę" Margin="6,0,0,0" />
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>

        <!-- Nawigacja + zawartość + panel karty (§10.4) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:NavigationView x:Name="Nawigacja" Grid.Column="0"
                               PaneDisplayMode="Left"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="True"
                               OpenPaneLength="220"
                               SelectionChanged="Nawigacja_SelectionChanged">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Pulpit" Tag="Pulpit">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Home24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Wyprawy" Tag="Wyprawy">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="CalendarMonth24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Broń" Tag="Bronie">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Target24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Wyposażenie" Tag="Wyposazenie">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Backpack24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Zestawy" Tag="Zestawy">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Grid24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Raporty" Tag="Raporty">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="DocumentBulletList24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Do uzupełnienia" Tag="DoUzupelnienia">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ClipboardTask24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="Słowniki" Tag="Slowniki">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="List24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Import" Tag="Import">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowImport24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Ustawienia" Tag="Ustawienia">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <!-- Środek: lista lub raport -->
            <ContentControl x:Name="ObszarZawartosci" Grid.Column="1" Margin="8" />

            <!-- Prawy panel karty (~420 px, zamykany) -->
            <Border x:Name="PanelKarty" Grid.Column="2" Width="420" Margin="0,8,8,8"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="12,8">
                        <TextBlock Text="Karta" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Appearance="Transparent" Click="ZamknijPanelKarty_Click"
                                   ToolTip="Zamknij panel">
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button>
                    </DockPanel>
                    <ContentControl Grid.Row="1" x:Name="ZawartoscKarty" Margin="12,0,12,12" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
