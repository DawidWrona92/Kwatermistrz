<Page x:Class="Kwatermistrz.App.Views.WyposazeniePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Kwatermistrz.App.Controls"
      xmlns:conv="clr-namespace:Kwatermistrz.App.Converters"
      Title="Wyposażenie" TextElement.Foreground="{DynamicResource TekstAplikacji}">
    <Page.Resources>
        <conv:KonwerterMiniatury x:Key="KonwerterMiniatury" />
        <conv:KonwerterNazwySlownika x:Key="KonwerterNazwySlownika" />
        <conv:KonwerterNazwySlownikaMulti x:Key="KonwerterNazwySlownikaMulti" />
        <conv:KonwerterNazwSlownikaWiele x:Key="KonwerterNazwSlownikaWiele" />
        <conv:KonwerterWaluty x:Key="KonwerterWaluty" />
        <conv:KonwerterNieRowneNull x:Key="KonwerterNieRowneNull" />
        <conv:KonwerterWiekszeOdZera x:Key="KonwerterWiekszeOdZera" />
        <conv:KonwerterWzorKamuflazu x:Key="KonwerterWzorKamuflazu" />
        <conv:KonwerterNazwaWzoru x:Key="KonwerterNazwaWzoru" />
    </Page.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Kategorie z licznikami (FR-201) -->
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Kategorie" Style="{StaticResource NaglowekSekcji}" Margin="4,4,4,8" />
            <Button Command="{Binding WybierzKategorieCommand}" CommandParameter="{x:Null}"
                    Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="8,4">
                <TextBlock Text="Wszystkie" />
            </Button>
            <ItemsControl ItemsSource="{Binding Kategorie}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.WybierzKategorieCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Nazwa}" />
                                <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static conv:KonwerterLicznikaKategorii.Instance}">
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Page}" />
                                            <Binding Path="Id" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Lista przedmiotów (FR-203) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <ui:TextBox MinWidth="220" PlaceholderText="Filtr…"
                            Text="{Binding FiltrTekst, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Pokaż sprzedane i wycofane" VerticalAlignment="Center" Margin="12,0,0,0"
                          IsChecked="{Binding PokazSprzedane}" />
                <CheckBox Content="Bez użyć" VerticalAlignment="Center" Margin="12,0,0,0"
                          IsChecked="{Binding TylkoBezUzycia}" ToolTip="Tylko przedmioty bez żadnego użycia (FR-104)" />
                <TextBlock Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="PPM na tabeli: dodawanie i usuwanie"
                           ToolTip="Prawy przycisk myszy na wierszu otwiera jego operacje. Zaznaczone checkboxami przedmioty obsługujesz zbiorczo." />
            </StackPanel>
            <TextBlock Grid.Row="1" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="Pozycji: " /><Run Text="{Binding LiczbaWierszy, Mode=OneWay}" />
            </TextBlock>
            <ui:DataGrid x:Name="PrzedmiotyTabela"
                         ContextMenuOpening="PrzedmiotyTabela_ContextMenuOpening"
                         Grid.Row="2"
                         ItemsSource="{Binding Wiersze}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         SelectedItem="{Binding Wybrany}"
                         HeadersVisibility="Column" GridLinesVisibility="All"
                         HorizontalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         VerticalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         BorderBrush="{DynamicResource LiniaTabeli}" BorderThickness="1"
                         AlternationCount="2"
                         AlternatingRowBackground="{DynamicResource WierszTabeliNaprzemienny}"
                         CanUserResizeColumns="True" ColumnWidth="*"
                         HorizontalScrollBarVisibility="Auto" controls:ProporcjonalneKolumny.Wlaczone="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="64" MinWidth="64" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Zaznaczony}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          MinWidth="24" MinHeight="24"
                                          Padding="0" Margin="5,2"
                                          ToolTip="Zaznacz przedmiot do edycji zbiorczej" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- NFR-08: próbka wzoru zawsze ma obok nazwę (tekst), tooltip z nazwą przy najechaniu -->
                    <DataGridTemplateColumn Header="Wzór" Width="1.6*" MinWidth="175">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:ProbkaKamuflazu Grid.Column="0">
                                        <controls:ProbkaKamuflazu.Wzor>
                                            <MultiBinding Converter="{x:Static conv:KonwerterWzorKamuflazu.Instance}">
                                                <Binding Path="WzorId" />
                                                <Binding Path="DataContext.Slowniki.Wzory" RelativeSource="{RelativeSource AncestorType=Page}" />
                                            </MultiBinding>
                                        </controls:ProbkaKamuflazu.Wzor>
                                        <controls:ProbkaKamuflazu.ToolTip>
                                            <MultiBinding Converter="{x:Static conv:KonwerterNazwaWzoru.Instance}">
                                                <Binding Path="WzorId" />
                                                <Binding Path="DataContext.Slowniki.Wzory" RelativeSource="{RelativeSource AncestorType=Page}" />
                                            </MultiBinding>
                                        </controls:ProbkaKamuflazu.ToolTip>
                                    </controls:ProbkaKamuflazu>
                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static conv:KonwerterNazwaWzoru.Instance}">
                                                <Binding Path="WzorId" />
                                                <Binding Path="DataContext.Slowniki.Wzory" RelativeSource="{RelativeSource AncestorType=Page}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Firma" Binding="{Binding Firma}" Width="1.25*" MinWidth="170" />
                    <DataGridTemplateColumn Header="Zdjęcie" Width="70" MinWidth="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Miniatura pierwszego zdjęcia (FR-211 [S]) -->
                                <Image Height="40" Stretch="UniformToFill"
                                       Source="{Binding ZdjecieMiniatury, Converter={StaticResource KonwerterMiniatury}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Nazwa" Binding="{Binding Nazwa}" Width="2.6*" MinWidth="215" />
                    <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Miejsce"
                                        Binding="{Binding MiejsceNazwa, Mode=OneWay}" Width="1.6*" MinWidth="185" />
                    <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Użycia" Binding="{Binding Uzycia}" Width="0.95*" MinWidth="75" />
                    <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Status" Binding="{Binding Status}" Width="1.25*" MinWidth="135" />
                    <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Komentarz" Binding="{Binding Komentarz}" Width="2.5*" MinWidth="220" />
                </DataGrid.Columns>
            </ui:DataGrid>

            <!-- Edycja zbiorcza (FR-216) -->
            <Border Grid.Row="3" Style="{StaticResource Karta}" Padding="8" Margin="0,8,0,0"
                    Visibility="{Binding LiczbaZaznaczonych, Converter={StaticResource KonwerterWiekszeOdZera}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                        <Run Text="Zaznaczone: " /><Run Text="{Binding LiczbaZaznaczonych, Mode=OneWay}" />
                    </TextBlock>
                    <ComboBox MinWidth="130" Margin="0,0,8,0" ItemsSource="{Binding Slowniki.Miejsca}"
                              SelectedValue="{Binding EdytowanyMiejsceId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa"
                              ToolTip="Miejsce (puste = bez zmian)" />
                    <ComboBox MinWidth="130" Margin="0,0,8,0" ItemsSource="{Binding Slowniki.Wzory}"
                              SelectedValue="{Binding EdytowanyWzorId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa"
                              ToolTip="Wzór (puste = bez zmian)" />
                    <ComboBox MinWidth="130" Margin="0,0,8,0" ItemsSource="{Binding Slowniki.Pochodzenie}"
                              SelectedValue="{Binding EdytowanyPochodzenieId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa"
                              ToolTip="Pochodzenie / klasa (puste = bez zmian)" />
                    <ui:Button Content="Zastosuj do zaznaczonych" Appearance="Primary"
                               Command="{Binding EdytujZbiorczoCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
