<Page x:Class="Kwatermistrz.App.Views.WyposazeniePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Kwatermistrz.App.Controls"
      xmlns:conv="clr-namespace:Kwatermistrz.App.Converters"
      Title="Wyposażenie">
    <Page.Resources>
        <conv:KonwerterMiniatury x:Key="KonwerterMiniatury" />
        <conv:KonwerterNazwySlownika x:Key="KonwerterNazwySlownika" />
        <conv:KonwerterNazwSlownikaWiele x:Key="KonwerterNazwSlownikaWiele" />
        <conv:KonwerterWaluty x:Key="KonwerterWaluty" />
        <conv:KonwerterNieRowneNull x:Key="KonwerterNieRowneNull" />
        <conv:KonwerterWiekszeOdZera x:Key="KonwerterWiekszeOdZera" />
        <conv:KonwerterWzorKamuflazu x:Key="KonwerterWzorKamuflazu" />
        <conv:KonwerterNazwaWzoru x:Key="KonwerterNazwaWzoru" />
    </Page.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Kategorie z licznikami (FR-201) -->
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Kategorie" Style="{StaticResource NaglowekSekcji}" Margin="4,4,4,8" />
            <Button Command="{Binding WybierzKategorieCommand}" CommandParameter="{x:Null}"
                    Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="8,4">
                <TextBlock Text="Wszystkie" />
            </Button>
            <ItemsControl ItemsSource="{Binding Kategorie}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.WybierzKategorieCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Nazwa}" />
                                <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static conv:KonwerterLicznikaKategorii.Instance}" ConverterParameter="{Binding Id}">
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Page}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Lista przedmiotów (FR-203) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <ui:TextBox MinWidth="220" PlaceholderText="Filtr…"
                            Text="{Binding FiltrTekst, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Pokaż sprzedane i wycofane" VerticalAlignment="Center" Margin="12,0,0,0"
                          IsChecked="{Binding PokazSprzedane}" />
                <CheckBox Content="Bez użyć" VerticalAlignment="Center" Margin="12,0,0,0"
                          IsChecked="{Binding TylkoBezUzycia}" ToolTip="Tylko przedmioty bez żadnego użycia (FR-104)" />
                <ui:Button Content="Dodaj przedmiot" Appearance="Primary" Margin="12,0,0,0"
                           Command="{Binding DodajCommand}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="Pozycji: " /><Run Text="{Binding LiczbaWierszy, Mode=OneWay}" />
            </TextBlock>
            <ui:DataGrid Grid.Row="2"
                         ItemsSource="{Binding Wiersze}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         SelectedItem="{Binding Wybrany}"
                         HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="30">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Zaznaczony}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- NFR-08: próbka wzoru zawsze ma obok nazwę (tekst), tooltip z nazwą przy najechaniu -->
                    <DataGridTemplateColumn Header="Wzór" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:ProbkaKamuflazu
                                        Wzor="{Binding WzorId, Converter={StaticResource KonwerterWzorKamuflazu}, ConverterParameter={Binding DataContext.DataContext.Slowniki.Wzory, RelativeSource={RelativeSource AncestorType=Page}}}"
                                        ToolTip="{Binding WzorId, Converter={StaticResource KonwerterNazwaWzoru}, ConverterParameter={Binding DataContext.DataContext.Slowniki.Wzory, RelativeSource={RelativeSource AncestorType=Page}}}" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding WzorId, Converter={StaticResource KonwerterNazwaWzoru}, ConverterParameter={Binding DataContext.DataContext.Slowniki.Wzory, RelativeSource={RelativeSource AncestorType=Page}}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Firma" Binding="{Binding Firma}" Width="120" />
                    <DataGridTemplateColumn Header="Zdjęcie" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Miniatura pierwszego zdjęcia (FR-211 [S]) -->
                                <Image Height="40" Stretch="UniformToFill"
                                       Source="{Binding ZdjecieMiniatury, Converter={StaticResource KonwerterMiniatury}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="*" />
                    <DataGridTextColumn Header="Miejsce" Binding="{Binding MiejsceId}" Width="110" />
                    <DataGridTextColumn Header="Użycia" Binding="{Binding Uzycia}" Width="70" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                    <DataGridTextColumn Header="Komentarz" Binding="{Binding Komentarz}" Width="160" />
                </DataGrid.Columns>
            </ui:DataGrid>

            <!-- Edycja zbiorcza (FR-216) -->
            <Border Grid.Row="3" Style="{StaticResource Karta}" Padding="8" Margin="0,8,0,0"
                    Visibility="{Binding LiczbaZaznaczonych, Converter={StaticResource KonwerterWiekszeOdZera}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                        <Run Text="Zaznaczone: " /><Run Text="{Binding LiczbaZaznaczonych, Mode=OneWay}" />
                    </TextBlock>
                    <ComboBox MinWidth="130" Margin="0,0,8,0" ItemsSource="{Binding Slowniki.Miejsca}"
                              SelectedValue="{Binding EdytowanyMiejsceId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa"
                              ToolTip="Miejsce (puste = bez zmian)" />
                    <ComboBox MinWidth="130" Margin="0,0,8,0" ItemsSource="{Binding Slowniki.Wzory}"
                              SelectedValue="{Binding EdytowanyWzorId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa"
                              ToolTip="Wzór (puste = bez zmian)" />
                    <ComboBox MinWidth="130" Margin="0,0,8,0" ItemsSource="{Binding Slowniki.Pochodzenie}"
                              SelectedValue="{Binding EdytowanyPochodzenieId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa"
                              ToolTip="Pochodzenie / klasa (puste = bez zmian)" />
                    <ui:Button Content="Zastosuj do zaznaczonych" Appearance="Primary"
                               Command="{Binding EdytujZbiorczoCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
