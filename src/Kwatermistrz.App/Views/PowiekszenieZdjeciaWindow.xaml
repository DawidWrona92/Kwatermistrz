<ui:FluentWindow x:Class="Kwatermistrz.App.Views.PowiekszenieZdjeciaWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Zdjęcie" Height="720" Width="960"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Powiększenie: dopasowanie do okna, przewijanie gdy większe (FR-211) -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource PlatnoBrush}">
            <Image x:Name="Obraz" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,8">
            <TextBlock x:Name="Etykieta" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <ui:Button Content="Zamknij" Appearance="Primary" Margin="12,0,0,0" Click="Zamknij_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
