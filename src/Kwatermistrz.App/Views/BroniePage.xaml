<Page x:Class="Kwatermistrz.App.Views.BroniePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:Kwatermistrz.App.Converters"
      Title="Broń">
    <Page.Resources>
        <conv:KonwerterWaluty x:Key="KonwerterWaluty" />
        <conv:KonwerterProcentu x:Key="KonwerterProcentu" />
        <conv:KonwerterDaty x:Key="KonwerterDaty" />
        <conv:KonwerterNazwySlownika x:Key="KonwerterNazwySlownika" />
        <conv:KonwerterNazwSlownikaWiele x:Key="KonwerterNazwSlownikaWiele" />
        <conv:KonwerterBoolToVisibility x:Key="KonwerterBoolToVisibility" />
        <conv:KonwerterRoznicyTlo x:Key="KonwerterRoznicyTlo" />
    </Page.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Pasek filtrów (FR-301) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <ui:TextBox MinWidth="200" PlaceholderText="Filtr…"
                        Text="{Binding FiltrTekst, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox MinWidth="120" Margin="8,0,0,0" ItemsSource="{Binding Slowniki.Strony}"
                      SelectedValue="{Binding FiltrStronaId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa"
                      ToolTip="Strona" />
            <ComboBox MinWidth="140" Margin="8,0,0,0" ItemsSource="{Binding Slowniki.StanyReplik}"
                      SelectedValue="{Binding FiltrStanId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa"
                      ToolTip="Stan" />
            <CheckBox Content="Tylko z otwartą awarią" VerticalAlignment="Center" Margin="12,0,0,0"
                      IsChecked="{Binding TylkoAwaria}" />
            <CheckBox Content="Bez testu" VerticalAlignment="Center" Margin="12,0,0,0"
                      IsChecked="{Binding TylkoBezTestu}" ToolTip="Bez testu dłużej niż próg z ustawień (FR-104)" />
            <CheckBox Content="Pokaż sprzedane i wycofane" VerticalAlignment="Center" Margin="12,0,0,0"
                      IsChecked="{Binding PokazSprzedane}" />
            <ui:Button Content="Dodaj replikę" Appearance="Primary" Margin="12,0,0,0"
                       Command="{Binding DodajCommand}" />
            <ui:Button Content="Porównaj zaznaczone (FR-406)" Margin="12,0,0,0"
                       Command="{Binding PrzelaczPorownanieCommand}"
                       ToolTip="Porównanie kart zaznaczonych replik (zaznacz checkboxem w pierwszej kolumnie)" />
        </StackPanel>

        <!-- Panel porównania kart (FR-406) -->
        <Border Grid.Row="0" Style="{StaticResource Karta}" Padding="8" Margin="0,40,0,8"
                Visibility="{Binding PokazPorownanie, Converter={StaticResource KonwerterBoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Porównanie kart (FR-406) — różnice podświetlone" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding PorownanieKart}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4" Margin="0,1" CornerRadius="4"
                                    Background="{Binding CzyRoznica, Converter={StaticResource KonwerterRoznicyTlo}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Parametr}" />
                                        <!-- NFR-08: różnica oznaczona też tekstem, nie tylko kolorem tła -->
                                        <TextBlock Text=" — różnica" Margin="6,0,0,0" FontSize="11"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   Visibility="{Binding CzyRoznica, Converter={StaticResource KonwerterBoolToVisibility}}" />
                                    </StackPanel>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Wartosci}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="0,0,1,0" Padding="4"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Lista replik (FR-301) -->
        <ui:DataGrid Grid.Row="1"
                     ItemsSource="{Binding Wiersze}"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     IsReadOnly="True"
                     SelectionMode="Single"
                     SelectedItem="{Binding Wybrana}"
                     HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Por." Width="36"
                                         Binding="{Binding ZaznaczonaDoPorownania, Mode=TwoWay}" />
                <DataGridTextColumn Header="#" Binding="{Binding MiejsceWRankingu}" Width="36" />
                <DataGridTextColumn Header="Nazwa" Binding="{Binding NazwaPelna}" Width="*" />
                <DataGridTextColumn Header="Strona" Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="StronyId" Converter="{StaticResource KonwerterNazwSlownikaWiele}"
                                 ConverterParameter="{Binding DataContext.Slowniki.Strony, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Rola" Width="110">
                    <DataGridTextColumn.Binding>
                        <Binding Path="RoleId" Converter="{StaticResource KonwerterNazwSlownikaWiele}"
                                 ConverterParameter="{Binding DataContext.Slowniki.Role, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Magazynek" Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="TypMagazynkaId" Converter="{StaticResource KonwerterNazwySlownika}"
                                 ConverterParameter="{Binding DataContext.Slowniki.TypyMagazynkow, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Napęd" Width="80">
                    <DataGridTextColumn.Binding>
                        <Binding Path="NapedId" Converter="{StaticResource KonwerterNazwySlownika}"
                                 ConverterParameter="{Binding DataContext.Slowniki.Napedy, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Stan" Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="StanId" Converter="{StaticResource KonwerterNazwySlownika}"
                                 ConverterParameter="{Binding DataContext.Slowniki.StanyReplik, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Wyprawy" Binding="{Binding Wyprawy}" Width="70" />
                <DataGridTextColumn Header="%" Width="60">
                    <DataGridTextColumn.Binding>
                        <Binding Path="ProcentWypraw" Converter="{StaticResource KonwerterProcentu}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Koszt całk." Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="KosztCalkowity" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Cena oryg." Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="CenaOryginalna" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Dodatki" Width="80">
                    <DataGridTextColumn.Binding>
                        <Binding Path="KosztDodatkow" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Koszt/wyp." Width="80">
                    <DataGridTextColumn.Binding>
                        <Binding Path="KosztNaWyprawe" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Ostatni test" Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="DataOstatniegoTestu" Converter="{StaticResource KonwerterDaty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Awaria" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="⚠" Visibility="{Binding CzyOtwartaAwaria, Converter={x:Static conv:KonwerterBoolToVisibility.Instance}}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" ToolTip="Otwarta awaria" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Akcje" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- FR-407: kopiuj kartę z tej repliki jako punkt wyjścia dla nowej -->
                                <ui:Button Padding="4,2" ToolTip="Kopiuj kartę z tej repliki do nowej (FR-407)"
                                           Command="{Binding DataContext.KopiujKarteZInnejCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}">
                                    <ui:SymbolIcon Symbol="Copy24" />
                                </ui:Button>
                                <ui:Button Padding="4,2" Margin="4,0,0,0" Appearance="Danger" ToolTip="Usuń replikę"
                                           Command="{Binding DataContext.UsunCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}">
                                    <ui:SymbolIcon Symbol="Dismiss24" />
                                </ui:Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</Page>
