<Page x:Class="Kwatermistrz.App.Views.RaportyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Kwatermistrz.App.Controls"
      xmlns:conv="clr-namespace:Kwatermistrz.App.Converters"
      xmlns:sys="clr-namespace:System;assembly=System.Runtime"
      Title="Raporty">
    <Page.Resources>
        <conv:KonwerterWaluty x:Key="KonwerterWaluty" />
        <conv:KonwerterProcentu x:Key="KonwerterProcentu" />
        <conv:KonwerterRowne x:Key="KonwerterRowne" />
        <conv:KonwerterDaty x:Key="KonwerterDaty" />
    </Page.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Raporty" Style="{StaticResource TytulEkranu}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <ComboBox MinWidth="180" ItemsSource="{Binding Raporty}"
                      SelectedItem="{Binding WybranyRaport}" />
            <CheckBox Content="Uwzględnij sprzedane" VerticalAlignment="Center" Margin="12,0,0,0"
                      IsChecked="{Binding UwzglednijSprzedane}"
                      Visibility="{Binding WybranyRaport, Converter={StaticResource KonwerterRowne}, ConverterParameter=Bronie}" />
            <ui:Button Content="Eksportuj CSV" Appearance="Primary" Margin="12,0,0,0"
                       Command="{Binding EksportujCsvCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,0,0,8" Opacity="0.7" TextWrapping="Wrap"
                   Text="„Jak liczymy” (FR-911): procent wypraw = wyprawy repliki / łączna liczba wypraw; koszt na wyprawę = koszt całkowity / wyprawy (przy zerowej liczbie wypraw = koszt całkowity); koszt dodatków = koszt całkowity − cena oryginalna; użycia = licznik historyczny + wyprawy ze składem." />

        <!-- Raport „Broń” (FR-901) -->
        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding RaportBroni}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column"
                     Visibility="{Binding WybranyRaport, Converter={StaticResource KonwerterRowne}, ConverterParameter=Bronie}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Miejsce}" Width="36" />
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="*" />
                <DataGridTextColumn Header="Wyprawy" Binding="{Binding Wyprawy}" Width="70" />
                <DataGridTextColumn Header="%" Width="60">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Procent" Converter="{StaticResource KonwerterProcentu}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Magazynek" Binding="{Binding TypMagazynka}" Width="90" />
                <DataGridTextColumn Header="Rola" Binding="{Binding Rola}" Width="120" />
                <DataGridTextColumn Header="Strona" Binding="{Binding Strona}" Width="90" />
                <DataGridTextColumn Header="Koszt" Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Koszt" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Cena oryg." Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="CenaOryginalna" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Dodatki" Width="80">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Dodatki" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Koszt/wyp." Width="80">
                    <DataGridTextColumn.Binding>
                        <Binding Path="KosztNaWyprawe" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- Raport „Umundurowanie” (FR-902) -->
        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding RaportUmundurowanie}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column"
                     Visibility="{Binding WybranyRaport, Converter={StaticResource KonwerterRowne}, ConverterParameter=Umundurowanie}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="*" />
                <DataGridTextColumn Header="Strona" Binding="{Binding Strona}" Width="90" />
                <DataGridTextColumn Header="Wzór" Binding="{Binding Wzor}" Width="120" />
                <DataGridTextColumn Header="Wyprawy" Binding="{Binding Wyprawy}" Width="70" />
                <DataGridTextColumn Header="%" Width="60">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Procent" Converter="{StaticResource KonwerterProcentu}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Koszt" Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Koszt" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Koszt/wyp." Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="KosztNaWyprawe" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- Raport „Wyprawy wg lat” (FR-903) -->
        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding RaportLata}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column"
                     Visibility="{Binding WybranyRaport, Converter={StaticResource KonwerterRowne}, ConverterParameter=Wyprawy wg lat}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Rok" Binding="{Binding Rok}" Width="80" />
                <DataGridTextColumn Header="Wyprawy" Binding="{Binding Wyprawy}" Width="90" />
                <DataGridTextColumn Header="Suma narastająco" Binding="{Binding SumaNarastajaco}" Width="130" />
                <DataGridTextColumn Header="Średnia na miesiąc" Binding="{Binding SredniaNaMiesiac, StringFormat=0.00}" Width="130" />
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- Raport „Użycie wyposażenia” (FR-904) -->
        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding RaportUzycia}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column"
                     Visibility="{Binding WybranyRaport, Converter={StaticResource KonwerterRowne}, ConverterParameter=Użycie wyposażenia}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="*" />
                <DataGridTextColumn Header="Kategoria" Binding="{Binding Kategoria}" Width="130" />
                <DataGridTextColumn Header="Użycia" Binding="{Binding Uzycia}" Width="70" />
                <DataGridTextColumn Header="Cena" Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Cena" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Koszt/użycie" Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="KosztNaUzycie" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- Raport „Koszty” (FR-905) -->
        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding RaportKoszty}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column"
                     Visibility="{Binding WybranyRaport, Converter={StaticResource KonwerterRowne}, ConverterParameter=Koszty}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Grupa" Binding="{Binding Grupa}" Width="120" />
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="*" />
                <DataGridTextColumn Header="Kwota" Width="110">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Kwota" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- Raport „Zestawy” (FR-906) -->
        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding RaportZestawy}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column"
                     Visibility="{Binding WybranyRaport, Converter={StaticResource KonwerterRowne}, ConverterParameter=Zestawy}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="*" />
                <DataGridTextColumn Header="Wyprawy" Binding="{Binding Wyprawy}" Width="70" />
                <DataGridTextColumn Header="%" Width="60">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Procent" Converter="{StaticResource KonwerterProcentu}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Ostatnie" Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="OstatnieUzycie" Converter="{StaticResource KonwerterDaty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Koszt zestawu" Width="100">
                    <DataGridTextColumn.Binding>
                        <Binding Path="KosztZestawu" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Koszt/wyp." Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="KosztNaWyprawe" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- Raport „Stan replik” (FR-907) -->
        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding RaportStan}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column"
                     Visibility="{Binding WybranyRaport, Converter={StaticResource KonwerterRowne}, ConverterParameter=Stan replik}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="*" />
                <DataGridTextColumn Header="Liczba" Width="120">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Liczba" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- Wykresy (FR-909) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding WybranyRaport, Converter={StaticResource KonwerterRowne}, ConverterParameter=Wykresy}">
            <StackPanel Margin="8">
                <Border Style="{StaticResource Karta}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <controls:WykresPionowy Tytul="Wyprawy wg lat" Dane="{Binding WykresWyprawyWgLat}" Height="220" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Karta}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <controls:WykresPoziomy Tytul="Udział wypraw wg strony" Dane="{Binding WykresUdzialWgStrony}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Karta}" Padding="12">
                    <StackPanel>
                        <controls:WykresPoziomy Tytul="Udział wypraw wg munduru" Dane="{Binding WykresUdzialWgMunduru}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Kontrola spójności (FR-910) -->
        <Border Grid.Row="2" Style="{StaticResource Karta}" Padding="16"
                Visibility="{Binding WybranyRaport, Converter={StaticResource KonwerterRowne}, ConverterParameter=Kontrola spójności}">
            <StackPanel>
                <TextBlock Text="Kontrola spójności (FR-910)" Style="{StaticResource NaglowekSekcji}" />
                <TextBlock Text="{Binding KontrolaSpójnosci}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
