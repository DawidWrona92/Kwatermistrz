<Page x:Class="Kwatermistrz.App.Views.RaportyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Kwatermistrz.App.Controls"
      xmlns:conv="clr-namespace:Kwatermistrz.App.Converters"
      xmlns:sys="clr-namespace:System;assembly=System.Runtime"
      Title="Raporty" TextElement.Foreground="{DynamicResource TekstAplikacji}">
    <Page.Resources>
        <conv:KonwerterWaluty x:Key="KonwerterWaluty" />
        <conv:KonwerterProcentu x:Key="KonwerterProcentu" />
        <conv:KonwerterRowne x:Key="KonwerterRowne" />
        <conv:KonwerterDaty x:Key="KonwerterDaty" />
    </Page.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Raporty" Style="{StaticResource TytulEkranu}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <ComboBox MinWidth="180" ItemsSource="{Binding Raporty}"
                      SelectedItem="{Binding WybranyRaport}" />
            <CheckBox Content="Uwzględnij sprzedane" VerticalAlignment="Center" Margin="12,0,0,0"
                      IsChecked="{Binding UwzglednijSprzedane}"
                      Visibility="{Binding WybranyRaport, Converter={x:Static conv:KonwerterRowneDoWidocznosci.Instance}, ConverterParameter=Bronie}" />
            <ui:Button Content="Eksportuj CSV" Appearance="Primary" Margin="12,0,0,0"
                       Command="{Binding EksportujCsvCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                   Text="„Jak liczymy” (FR-911): procent wypraw = wyprawy repliki / łączna liczba wypraw; koszt na wyprawę = koszt całkowity / wyprawy (przy zerowej liczbie wypraw = koszt całkowity); koszt dodatków = koszt całkowity − cena oryginalna; użycia = licznik historyczny + wyprawy ze składem." />

        <!-- Raport „Broń” (FR-901) -->
        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding RaportBroni}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column"
                     Visibility="{Binding WybranyRaport, Converter={x:Static conv:KonwerterRowneDoWidocznosci.Instance}, ConverterParameter=Bronie}" GridLinesVisibility="All"
                         HorizontalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         VerticalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         BorderBrush="{DynamicResource LiniaTabeli}" BorderThickness="1"
                         AlternationCount="2"
                         AlternatingRowBackground="{DynamicResource WierszTabeliNaprzemienny}"
                         CanUserResizeColumns="True" ColumnWidth="*"
                         HorizontalScrollBarVisibility="Auto" controls:ProporcjonalneKolumny.Wlaczone="True">
            <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="#" Binding="{Binding Miejsce}" Width="0.55*" MinWidth="75" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Nazwa" Binding="{Binding Nazwa}" Width="2.6*" MinWidth="215" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Wyprawy" Binding="{Binding Wyprawy}" Width="0.95*" MinWidth="75" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="%" Width="0.65*" MinWidth="75">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Procent" Converter="{StaticResource KonwerterProcentu}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Magazynek" Binding="{Binding TypMagazynka}" Width="1.6*" MinWidth="170" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Rola" Binding="{Binding Rola}" Width="1.25*" MinWidth="135" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Strona" Binding="{Binding Strona}" Width="1.25*" MinWidth="135" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Koszt" Width="1.35*" MinWidth="105">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Koszt" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Cena oryg." Width="1.35*" MinWidth="145">
                    <DataGridTextColumn.Binding>
                        <Binding Path="CenaOryginalna" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Dodatki" Width="1.35*" MinWidth="145">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Dodatki" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Koszt/wyp." Width="1.35*" MinWidth="105">
                    <DataGridTextColumn.Binding>
                        <Binding Path="KosztNaWyprawe" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- Raport „Umundurowanie” (FR-902) -->
        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding RaportUmundurowanie}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column"
                     Visibility="{Binding WybranyRaport, Converter={x:Static conv:KonwerterRowneDoWidocznosci.Instance}, ConverterParameter=Umundurowanie}" GridLinesVisibility="All"
                         HorizontalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         VerticalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         BorderBrush="{DynamicResource LiniaTabeli}" BorderThickness="1"
                         AlternationCount="2"
                         AlternatingRowBackground="{DynamicResource WierszTabeliNaprzemienny}"
                         CanUserResizeColumns="True" ColumnWidth="*"
                         HorizontalScrollBarVisibility="Auto" controls:ProporcjonalneKolumny.Wlaczone="True">
            <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Nazwa" Binding="{Binding Nazwa}" Width="2.6*" MinWidth="215" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Strona" Binding="{Binding Strona}" Width="1.25*" MinWidth="135" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Wzór" Binding="{Binding Wzor}" Width="1.6*" MinWidth="170" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Wyprawy" Binding="{Binding Wyprawy}" Width="0.95*" MinWidth="75" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="%" Width="0.65*" MinWidth="75">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Procent" Converter="{StaticResource KonwerterProcentu}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Koszt" Width="1.35*" MinWidth="105">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Koszt" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Koszt/wyp." Width="1.35*" MinWidth="105">
                    <DataGridTextColumn.Binding>
                        <Binding Path="KosztNaWyprawe" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- Raport „Wyprawy wg lat” (FR-903) -->
        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding RaportLata}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column"
                     Visibility="{Binding WybranyRaport, Converter={x:Static conv:KonwerterRowneDoWidocznosci.Instance}, ConverterParameter=Wyprawy wg lat}" GridLinesVisibility="All"
                         HorizontalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         VerticalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         BorderBrush="{DynamicResource LiniaTabeli}" BorderThickness="1"
                         AlternationCount="2"
                         AlternatingRowBackground="{DynamicResource WierszTabeliNaprzemienny}"
                         CanUserResizeColumns="True" ColumnWidth="*"
                         HorizontalScrollBarVisibility="Auto" controls:ProporcjonalneKolumny.Wlaczone="True">
            <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Rok" Binding="{Binding Rok}" Width="0.95*" MinWidth="75" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Wyprawy" Binding="{Binding Wyprawy}" Width="0.95*" MinWidth="75" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Suma narastająco" Binding="{Binding SumaNarastajaco}" Width="1.5*" MinWidth="145" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Średnia na miesiąc" Binding="{Binding SredniaNaMiesiac, StringFormat=0.00}" Width="1.5*" MinWidth="130" />
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- Raport „Użycie wyposażenia” (FR-904) -->
        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding RaportUzycia}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column"
                     Visibility="{Binding WybranyRaport, Converter={x:Static conv:KonwerterRowneDoWidocznosci.Instance}, ConverterParameter=Użycie wyposażenia}" GridLinesVisibility="All"
                         HorizontalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         VerticalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         BorderBrush="{DynamicResource LiniaTabeli}" BorderThickness="1"
                         AlternationCount="2"
                         AlternatingRowBackground="{DynamicResource WierszTabeliNaprzemienny}"
                         CanUserResizeColumns="True" ColumnWidth="*"
                         HorizontalScrollBarVisibility="Auto" controls:ProporcjonalneKolumny.Wlaczone="True">
            <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Nazwa" Binding="{Binding Nazwa}" Width="2.6*" MinWidth="215" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Kategoria" Binding="{Binding Kategoria}" Width="1.6*" MinWidth="135" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Użycia" Binding="{Binding Uzycia}" Width="0.95*" MinWidth="75" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Cena" Width="1.35*" MinWidth="105">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Cena" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Koszt/użycie" Width="1.35*" MinWidth="145">
                    <DataGridTextColumn.Binding>
                        <Binding Path="KosztNaUzycie" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- Raport „Koszty” (FR-905) -->
        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding RaportKoszty}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column"
                     Visibility="{Binding WybranyRaport, Converter={x:Static conv:KonwerterRowneDoWidocznosci.Instance}, ConverterParameter=Koszty}" GridLinesVisibility="All"
                         HorizontalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         VerticalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         BorderBrush="{DynamicResource LiniaTabeli}" BorderThickness="1"
                         AlternationCount="2"
                         AlternatingRowBackground="{DynamicResource WierszTabeliNaprzemienny}"
                         CanUserResizeColumns="True" ColumnWidth="*"
                         HorizontalScrollBarVisibility="Auto" controls:ProporcjonalneKolumny.Wlaczone="True">
            <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Grupa" Binding="{Binding Grupa}" Width="1.25*" MinWidth="135" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Nazwa" Binding="{Binding Nazwa}" Width="2.6*" MinWidth="215" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Kwota" Width="1.35*" MinWidth="145">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Kwota" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- Raport „Zestawy” (FR-906) -->
        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding RaportZestawy}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column"
                     Visibility="{Binding WybranyRaport, Converter={x:Static conv:KonwerterRowneDoWidocznosci.Instance}, ConverterParameter=Zestawy}" GridLinesVisibility="All"
                         HorizontalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         VerticalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         BorderBrush="{DynamicResource LiniaTabeli}" BorderThickness="1"
                         AlternationCount="2"
                         AlternatingRowBackground="{DynamicResource WierszTabeliNaprzemienny}"
                         CanUserResizeColumns="True" ColumnWidth="*"
                         HorizontalScrollBarVisibility="Auto" controls:ProporcjonalneKolumny.Wlaczone="True">
            <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Nazwa" Binding="{Binding Nazwa}" Width="2.6*" MinWidth="215" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Wyprawy" Binding="{Binding Wyprawy}" Width="0.95*" MinWidth="75" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="%" Width="0.65*" MinWidth="75">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Procent" Converter="{StaticResource KonwerterProcentu}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Ostatnie" Width="1.3*" MinWidth="110">
                    <DataGridTextColumn.Binding>
                        <Binding Path="OstatnieUzycie" Converter="{StaticResource KonwerterDaty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Koszt zestawu" Width="1.6*" MinWidth="145">
                    <DataGridTextColumn.Binding>
                        <Binding Path="KosztZestawu" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Koszt/wyp." Width="1.35*" MinWidth="105">
                    <DataGridTextColumn.Binding>
                        <Binding Path="KosztNaWyprawe" Converter="{StaticResource KonwerterWaluty}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- Raport „Stan replik” (FR-907) -->
        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding RaportStan}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column"
                     Visibility="{Binding WybranyRaport, Converter={x:Static conv:KonwerterRowneDoWidocznosci.Instance}, ConverterParameter=Stan replik}" GridLinesVisibility="All"
                         HorizontalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         VerticalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         BorderBrush="{DynamicResource LiniaTabeli}" BorderThickness="1"
                         AlternationCount="2"
                         AlternatingRowBackground="{DynamicResource WierszTabeliNaprzemienny}"
                         CanUserResizeColumns="True" ColumnWidth="*"
                         HorizontalScrollBarVisibility="Auto" controls:ProporcjonalneKolumny.Wlaczone="True">
            <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Nazwa" Binding="{Binding Nazwa}" Width="2.6*" MinWidth="215" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Liczba" Width="0.95*" MinWidth="75">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Liczba" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- Wykresy (FR-909) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding WybranyRaport, Converter={x:Static conv:KonwerterRowneDoWidocznosci.Instance}, ConverterParameter=Wykresy}">
            <StackPanel Margin="8">
                <Border Style="{StaticResource Karta}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <controls:WykresPionowy Tytul="Wyprawy wg lat" Dane="{Binding WykresWyprawyWgLat}" Height="220" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Karta}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <controls:WykresPoziomy Tytul="Udział wypraw wg strony" Dane="{Binding WykresUdzialWgStrony}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Karta}" Padding="12">
                    <StackPanel>
                        <controls:WykresPoziomy Tytul="Udział wypraw wg munduru" Dane="{Binding WykresUdzialWgMunduru}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Kontrola spójności (FR-910) -->
        <Border Grid.Row="2" Style="{StaticResource Karta}" Padding="16"
                Visibility="{Binding WybranyRaport, Converter={x:Static conv:KonwerterRowneDoWidocznosci.Instance}, ConverterParameter=Kontrola spójności}">
            <StackPanel>
                <TextBlock Text="Kontrola spójności (FR-910)" Style="{StaticResource NaglowekSekcji}" />
                <TextBlock Text="{Binding KontrolaSpójnosci}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
