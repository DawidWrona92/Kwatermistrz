<UserControl x:Class="Kwatermistrz.App.Views.KartaRepliki"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Kwatermistrz.App.Converters"
             xmlns:model="clr-namespace:Kwatermistrz.Core.Model;assembly=Kwatermistrz.Core"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <UserControl.Resources>
        <conv:KonwerterWaluty x:Key="KonwerterWaluty" />
        <conv:KonwerterProcentu x:Key="KonwerterProcentu" />
        <conv:KonwerterDaty x:Key="KonwerterDaty" />
        <conv:KonwerterNazwySlownika x:Key="KonwerterNazwySlownika" />
        <conv:KonwerterNazwSlownikaWiele x:Key="KonwerterNazwSlownikaWiele" />
        <conv:KonwerterRowne x:Key="KonwerterRowne" />
        <conv:KonwerterNieRowne x:Key="KonwerterNieRowne" />
        <conv:KonwerterNieRowneNull x:Key="KonwerterNieRowneNull" />
        <conv:KonwerterBoolToVisibility x:Key="KonwerterBoolToVisibility" />
        <ObjectDataProvider x:Key="Statusy" MethodName="GetValues" ObjectType="{x:Type sys:Enum}"
                           >
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:StatusWlasnosci" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="StanyPola" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:StanWartosciPola" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="WynikiTestu" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:WynikTestu" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Zakładki (FR-302) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton Content="Przegląd" GroupName="Zakladki" IsChecked="{Binding Zakladka, Converter={StaticResource KonwerterRowne}, ConverterParameter=Przegląd}" />
            <RadioButton Content="Karta techniczna" GroupName="Zakladki" Margin="8,0,0,0" IsChecked="{Binding Zakladka, Converter={StaticResource KonwerterRowne}, ConverterParameter=Karta}" />
            <RadioButton Content="Pomiary" GroupName="Zakladki" Margin="8,0,0,0" IsChecked="{Binding Zakladka, Converter={StaticResource KonwerterRowne}, ConverterParameter=Pomiary}" />
            <RadioButton Content="Modyfikacje i koszty" GroupName="Zakladki" Margin="8,0,0,0" IsChecked="{Binding Zakladka, Converter={StaticResource KonwerterRowne}, ConverterParameter=Modyfikacje}" />
            <RadioButton Content="Zadania" GroupName="Zakladki" Margin="8,0,0,0" IsChecked="{Binding Zakladka, Converter={StaticResource KonwerterRowne}, ConverterParameter=Zadania}" />
            <RadioButton Content="Wyprawy" GroupName="Zakladki" Margin="8,0,0,0" IsChecked="{Binding Zakladka, Converter={StaticResource KonwerterRowne}, ConverterParameter=Wyprawy}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <!-- Przegląd (FR-304) -->
            <StackPanel Visibility="{Binding Zakladka, Converter={StaticResource KonwerterRowne}, ConverterParameter=Przegląd, ConverterCulture=pl-PL}">
                <TextBlock Text="{Binding NazwaPelna}" Style="{StaticResource NaglowekSekcji}" />
                <TextBlock Margin="0,4,0,0">
                    <Run Text="Status: " /><Run Text="{Binding Status}" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0">
                    <Run Text="Wyprawy: " /><Run Text="{Binding Wyprawy}" />
                    <Run Text=" (" /><Run Text="{Binding ProcentWypraw, Converter={StaticResource KonwerterProcentu}}" />
                    <Run Text=")" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0">
                    <Run Text="Koszt całkowity: " /><Run Text="{Binding KosztCalkowity, Converter={StaticResource KonwerterWaluty}}" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0">
                    <Run Text="Cena oryginalna: " /><Run Text="{Binding CenaOryginalna, Converter={StaticResource KonwerterWaluty}}" />
                    <Run Text="  Dodatki: " />
                    <Run Text="{Binding KosztDodatkow, Converter={StaticResource KonwerterWaluty}}" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0">
                    <Run Text="Koszt na wyprawę: " /><Run Text="{Binding KosztNaWyprawe, Converter={StaticResource KonwerterWaluty}}" />
                </TextBlock>
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal"
                            Visibility="{Binding OstatniPomiar, Converter={StaticResource KonwerterNieRowneNull}}">
                    <TextBlock Text="Ostatni pomiar: " />
                    <TextBlock Text="{Binding OstatniPomiar.Data, Converter={StaticResource KonwerterDaty}}" />
                    <TextBlock Text=" — energia " />
                    <TextBlock Text="{Binding OstatniPomiar.EnergiaJ}" />
                    <TextBlock Text=" J" />
                    <TextBlock Text=" (na maksimum)"
                               Visibility="{Binding OstatniPomiar.NaMaksimum, Converter={StaticResource KonwerterBoolToVisibility}}" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0">
                    <Run Text="Ostatni test: " /><Run Text="{Binding DataOstatniegoTestu, Converter={StaticResource KonwerterDaty}}" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0">
                    <Run Text="Otwarte zadania: " /><Run Text="{Binding OtwarteZadania}" />
                </TextBlock>
                <TextBlock Text="Ostatnie wyprawy:" Style="{StaticResource NaglowekSekcji}" Margin="0,12,0,4" />
                <ItemsControl ItemsSource="{Binding OstatnieWyprawy}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,2">
                                <Run Text="{Binding Data, Converter={StaticResource KonwerterDaty}}" />
                                <Run Text=" — " />
                                <Run Text="{Binding Miejsce}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Pola podstawowe (FR-303) -->
                <TextBlock Text="Pola podstawowe" Style="{StaticResource NaglowekSekcji}" Margin="0,16,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Replika.ModelProducenta}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Prototyp" VerticalAlignment="Center" Margin="0,4,0,0" />
                    <ui:TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Text="{Binding Replika.Prototyp}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Napęd" VerticalAlignment="Center" Margin="0,4,0,0" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                              ItemsSource="{Binding DataContext.DataContext.Slowniki.Napedy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedValue="{Binding Replika.NapedId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Typ magazynka" VerticalAlignment="Center" Margin="0,4,0,0" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,0"
                              ItemsSource="{Binding DataContext.DataContext.Slowniki.TypyMagazynkow, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedValue="{Binding Replika.TypMagazynkaId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Stan" VerticalAlignment="Center" Margin="0,4,0,0" />
                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4,0,0"
                              ItemsSource="{Binding DataContext.DataContext.Slowniki.StanyReplik, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedValue="{Binding Replika.StanId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Energia docelowa" VerticalAlignment="Center" Margin="0,4,0,0" />
                    <ui:TextBox Grid.Row="5" Grid.Column="1" Margin="0,4,0,0" Text="{Binding Replika.EnergiaDocelowaJ}" ToolTip="J" />
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Status" VerticalAlignment="Center" Margin="0,4,0,0" />
                    <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,4,0,0"
                              ItemsSource="{Binding Source={StaticResource Statusy}}"
                              SelectedItem="{Binding Replika.Status}" />
                </Grid>
            </StackPanel>

            <!-- Karta techniczna (FR-401, FR-404) -->
            <StackPanel Visibility="{Binding Zakladka, Converter={StaticResource KonwerterRowne}, ConverterParameter=Karta, ConverterCulture=pl-PL}">
                <ItemsControl ItemsSource="{Binding ParametryKartyWybranej}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Nazwa}" VerticalAlignment="Center" />
                                <ui:TextBox Grid.Column="1" Text="{Binding Wartosc.Tekst}" />
                                <ComboBox Grid.Column="2" Margin="8,0,0,0"
                                          ItemsSource="{Binding Source={StaticResource StanyPola}}"
                                          SelectedItem="{Binding Wartosc.Stan}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Pomiary (FR-408, FR-409) -->
            <StackPanel Visibility="{Binding Zakladka, Converter={StaticResource KonwerterRowne}, ConverterParameter=Pomiary, ConverterCulture=pl-PL}">
                <ui:Button Content="Dodaj pomiar/test" Appearance="Primary" Command="{Binding DataContext.DataContext.DodajPomiarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <ItemsControl ItemsSource="{Binding Replika.Pomiary}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" Padding="6" Margin="0,2"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" SelectedDate="{Binding Data}" />
                                    <ui:TextBox Grid.Column="1" Margin="4,0" Text="{Binding EnergiaJ}" ToolTip="Energia (J)" />
                                    <ui:TextBox Grid.Column="2" Margin="4,0" Text="{Binding Rof}" ToolTip="ROF" />
                                    <ui:TextBox Grid.Column="3" Margin="4,0" Text="{Binding ZasiegM}" ToolTip="Zasięg (m)" />
                                    <ComboBox Grid.Column="4" Margin="4,0" ItemsSource="{Binding Source={StaticResource WynikiTestu}}" SelectedItem="{Binding Wynik}" />
                                    <CheckBox Grid.Column="5" Margin="8,0" Content="Na maksimum" IsChecked="{Binding NaMaksimum}" VerticalAlignment="Center" />
                                    <ui:Button Grid.Column="6" Appearance="Danger"
                                               Command="{Binding DataContext.DataContext.UsunPomiarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss24" />
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Modyfikacje i koszty (FR-501, FR-504, FR-505) -->
            <StackPanel Visibility="{Binding Zakladka, Converter={StaticResource KonwerterRowne}, ConverterParameter=Modyfikacje, ConverterCulture=pl-PL}">
                <TextBlock Text="Pozycje kosztowe" Style="{StaticResource NaglowekSekcji}" />
                <ui:Button Content="Dodaj pozycję kosztową" Appearance="Primary" Margin="0,4,0,0"
                           Command="{Binding DataContext.DataContext.DodajKosztCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <ItemsControl ItemsSource="{Binding Replika.Koszty}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <DatePicker Grid.Column="0" SelectedDate="{Binding Data}" />
                                <ui:TextBox Grid.Column="1" Margin="4,0" Text="{Binding Opis}" ToolTip="Opis" />
                                <ui:TextBox Grid.Column="2" Margin="4,0" Text="{Binding Kwota}" ToolTip="Kwota (PLN, ujemna = zwrot)" />
                                <ComboBox Grid.Column="3" Margin="4,0"
                                          ItemsSource="{Binding DataContext.DataContext.DataContext.Slowniki.RodzajeKosztow, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValue="{Binding RodzajId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa" />
                                <ui:Button Grid.Column="4" Appearance="Danger"
                                           Command="{Binding DataContext.DataContext.UsunKosztCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}">
                                    <ui:SymbolIcon Symbol="Dismiss24" />
                                </ui:Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Modyfikacje (oś czasu, FR-505)" Style="{StaticResource NaglowekSekcji}" Margin="0,16,0,4" />
                <ui:Button Content="Dodaj modyfikację" Appearance="Primary" Margin="0,4,0,0"
                           Command="{Binding DataContext.DataContext.DodajModyfikacjeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <ItemsControl ItemsSource="{Binding Replika.Modyfikacje}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" Padding="6" Margin="0,2"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <DatePicker SelectedDate="{Binding Data}" />
                                        <ui:TextBox MinWidth="200" Margin="8,0,0,0" Text="{Binding Opis}" ToolTip="Opis modyfikacji" />
                                        <ui:Button Margin="8,0,0,0" Appearance="Danger"
                                                   Command="{Binding DataContext.DataContext.UsunModyfikacjeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Dismiss24" />
                                        </ui:Button>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Zmiany}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <ui:TextBox MinWidth="150" Text="{Binding ParametrId}" ToolTip="Parametr" />
                                                    <ui:TextBox MinWidth="120" Margin="8,0,0,0" Text="{Binding WartoscPrzed}" ToolTip="Wartość przed" />
                                                    <TextBlock Text="→" VerticalAlignment="Center" Margin="6,0" />
                                                    <ui:TextBox MinWidth="120" Margin="6,0,0,0" Text="{Binding WartoscPo}" ToolTip="Wartość po" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Zadania (FR-601, FR-602) -->
            <StackPanel Visibility="{Binding Zakladka, Converter={StaticResource KonwerterRowne}, ConverterParameter=Zadania, ConverterCulture=pl-PL}">
                <ui:Button Content="Dodaj zadanie" Appearance="Primary"
                           Command="{Binding DataContext.DataContext.DodajZadanieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <ItemsControl ItemsSource="{Binding DataContext.DataContext.ZadaniaWybranej, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" Padding="6" Margin="0,2"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Status, Converter={StaticResource KonwerterRowne}, ConverterParameter=Zamkniete}"
                                              VerticalAlignment="Center" ToolTip="Zamknięte" />
                                    <ui:TextBox MinWidth="220" Margin="8,0" Text="{Binding Opis}" />
                                    <ComboBox MinWidth="120" Margin="4,0"
                                              ItemsSource="{Binding DataContext.DataContext.DataContext.Slowniki.RodzajeZadan, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValue="{Binding RodzajId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa" />
                                    <TextBlock VerticalAlignment="Center" Margin="8,0" Text="{Binding Status}" />
                                    <ui:Button Margin="8,0,0,0" Content="Zamknij"
                                               Command="{Binding DataContext.DataContext.ZamknijZadanieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Margin="4,0,0,0" Appearance="Danger"
                                               Command="{Binding DataContext.DataContext.UsunZadanieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss24" />
                                    </ui:Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Wyprawy (FR-304) -->
            <StackPanel Visibility="{Binding Zakladka, Converter={StaticResource KonwerterRowne}, ConverterParameter=Wyprawy, ConverterCulture=pl-PL}">
                <ItemsControl ItemsSource="{Binding DataContext.DataContext.WyprawyWybranej, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Data, Converter={StaticResource KonwerterDaty}}" />
                                <TextBlock Text=" — " />
                                <TextBlock Text="{Binding Miejsce}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Pasek akcji karty -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <ui:Button Content="Zapisz" Appearance="Primary"
                       Command="{Binding DataContext.DataContext.ZapiszKarteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <ui:Button Content="Usuń replikę" Appearance="Danger" Margin="8,0,0,0"
                       Command="{Binding DataContext.DataContext.UsunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       CommandParameter="{Binding}" />
        </StackPanel>
    </Grid>
</UserControl>
