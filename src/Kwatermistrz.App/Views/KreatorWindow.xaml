<Window x:Class="Kwatermistrz.App.Views.KreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Kwatermistrz.App.Converters"
        Title="Kwatermistrz — pierwsze uruchomienie"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <!-- Lokalne style kreatora: WPF-UI aktualizuje kolory zasobów po zmianie motywu,
         ale natywne kontrolki WPF nie mogą wrócić do czarnego tekstu na ciemnym tle. -->
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style x:Key="PrzyciskKreatora" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#2F4A6B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2F4A6B" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style x:Key="PrzyciskDrugorzedny" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Witaj w Kwatermistrzu" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Kreator pierwszego uruchomienia (FR-1401). Wybierz punkt startu — resztę skonfigurujesz później."
                       TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Punkt startu" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Starty}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="Start" Margin="0,4,0,0"
                                         Checked="Start_Checked"
                                         Content="{Binding Nazwa}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Mode="OneWay" Converter="{x:Static conv:KonwerterRowneSlownik.Instance}">
                                        <Binding Path="DataContext.WybranyStart" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        <Binding Path="Klucz" />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Import z arkusza (FR-1101) — widoczny tylko przy wyborze „import” -->
                <StackPanel Margin="24,8,0,0"
                            Visibility="{Binding WybranyStart, Converter={x:Static conv:KonwerterRowneDoWidocznosci.Instance}, ConverterParameter=import}">
                    <TextBlock Text="Plik źródłowy (układ Dane_zrodlowe_Kwatermistrz.xlsx)" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox MinWidth="300" IsReadOnly="True" Text="{Binding SciezkaImportu, Mode=OneWay}" />
                        <Button Content="Wybierz…" Margin="8,0,0,0" Style="{StaticResource PrzyciskDrugorzedny}" Command="{Binding WybierzPlikImportuCommand}" />
                    </StackPanel>
                    <TextBlock Text="Import działa z podglądem — po kreatorze zobaczysz, co powstanie, i zatwierdzisz przed zapisem (FR-1102)."
                               TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBlock Text="Nazwa rekonstrukcji (przy starcie pustym/przykładowym; przy imporcie powstają rekonstrukcje ze stron)" Margin="0,16,0,0" TextWrapping="Wrap" />
                <TextBox Margin="0,4,0,0" Text="{Binding NazwaRekonstrukcji, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Strona (opcjonalnie)" Margin="0,16,0,0" />
                <ComboBox Margin="0,4,0,0"
                          ItemsSource="{Binding Strony}"
                          SelectedValue="{Binding WybranaStronaId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Nazwa" />
                <TextBlock Text="{Binding Komunikat}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Rozpocznij" IsDefault="True" Style="{StaticResource PrzyciskKreatora}" Command="{Binding PotwierdzCommand}" />
        </StackPanel>
    </Grid>
</Window>
