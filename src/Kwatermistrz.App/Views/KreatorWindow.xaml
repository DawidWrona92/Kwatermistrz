<Window x:Class="Kwatermistrz.App.Views.KreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Kwatermistrz — pierwsze uruchomienie"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Witaj w Kwatermistrzu" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Kreator pierwszego uruchomienia (FR-1401). Nazwij swoją pierwszą rekonstrukcję — resztę skonfigurujesz później."
                       TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.8" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="Nazwa rekonstrukcji (np. „101. Dywizja Powietrznodesantowa”)" />
            <ui:TextBox Margin="0,4,0,0" Text="{Binding NazwaRekonstrukcji, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Strona (opcjonalnie)" Margin="0,16,0,0" />
            <ComboBox Margin="0,4,0,0"
                      ItemsSource="{Binding Strony}"
                      SelectedValue="{Binding WybranaStronaId}"
                      SelectedValuePath="Id"
                      DisplayMemberPath="Nazwa" />
            <TextBlock Text="Punkt startu: pusta aplikacja ze słownikami startowymi. Import danych i szablony pojawią się w kolejnych krokach."
                       TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <ui:Button Content="Rozpocznij" Appearance="Primary" Command="{Binding PotwierdzCommand}" />
        </StackPanel>
    </Grid>
</Window>
