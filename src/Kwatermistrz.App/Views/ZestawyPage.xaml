<Page x:Class="Kwatermistrz.App.Views.ZestawyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Kwatermistrz.App.Controls"
      xmlns:conv="clr-namespace:Kwatermistrz.App.Converters"
      xmlns:app="clr-namespace:Kwatermistrz.App"
      Title="Zestawy" TextElement.Foreground="{DynamicResource TekstAplikacji}">
    <Page.Resources>
        <conv:KonwerterDaty x:Key="KonwerterDaty" />
        <conv:KonwerterProcentu x:Key="KonwerterProcentu" />
        <conv:KonwerterNazwySlownika x:Key="KonwerterNazwySlownika" />
        <conv:KonwerterNieRowneNull x:Key="KonwerterNieRowneNull" />
        <conv:KonwerterWaluty x:Key="KonwerterWaluty" />
        <conv:KonwerterBoolToVisibility x:Key="KonwerterBoolToVisibility" />
        <conv:KonwerterRowneTyp x:Key="KonwerterRowneTyp" />
        <conv:KonwerterRowneIdWariantu x:Key="KonwerterRowneIdWariantu" />
    </Page.Resources>
    <Grid x:Name="SiatkaZestawow" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Prawdziwe kolumny Grid (nie StackPanel); użytkownik może złapać
                 splitter i rozszerzyć listę bez zmiany wielkości całego okna. -->
            <ColumnDefinition x:Name="KolumnaListyZestawow"
                              Width="2*" MinWidth="320" MaxWidth="900" />
            <ColumnDefinition Width="7" />
            <ColumnDefinition Width="3*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- Lewy panel wypełnia dostępną wysokość, tabela przewija się wewnątrz. -->
        <Grid x:Name="LewyPanelZestawow" Grid.Column="0" Margin="0,0,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Zestawy" Style="{StaticResource TytulEkranu}" />
            <Grid Grid.Row="1" Margin="0,8,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" PlaceholderText="Filtr…"
                            Text="{Binding FiltrTekst, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Grid.Column="1" Content="Nowy" Appearance="Primary" Margin="8,0,0,0"
                           Command="{Binding DodajCommand}" />
            </Grid>
            <CheckBox Grid.Row="2" Content="Tylko szkice" VerticalAlignment="Center"
                      Margin="0,0,0,8" IsChecked="{Binding TylkoSzkice}" />
            <ui:DataGrid x:Name="ListaZestawow" Grid.Row="3"
                         MinHeight="180" MinWidth="0"
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                         VerticalScrollBarVisibility="Auto"
                         ItemsSource="{Binding Wiersze}"
                         AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                         SelectionMode="Single" SelectedItem="{Binding Wybrany}"
                         HeadersVisibility="Column" GridLinesVisibility="All"
                         HorizontalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         VerticalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         BorderBrush="{DynamicResource LiniaTabeli}" BorderThickness="1"
                         AlternationCount="2"
                         AlternatingRowBackground="{DynamicResource WierszTabeliNaprzemienny}"
                         CanUserResizeColumns="True" ColumnWidth="*"
                         HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Nazwa" Binding="{Binding Nazwa}" Width="2.6*" MinWidth="155" />
                    <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Wyprawy" Binding="{Binding Wyprawy}" Width="0.95*" MinWidth="75" />
                    <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="%" Width="0.65*" MinWidth="58">
                        <DataGridTextColumn.Binding>
                            <Binding Path="Procent" Converter="{StaticResource KonwerterProcentu}" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Ostatnie" Width="1.3*" MinWidth="100">
                        <DataGridTextColumn.Binding>
                            <Binding Path="OstatnieUzycie" Converter="{StaticResource KonwerterDaty}" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </ui:DataGrid>
        </Grid>

        <!-- Rozdzielacz z wyraźnym uchwytem, którego można używać myszą. -->
        <GridSplitter x:Name="PodzialZestawow" Grid.Column="1"
                      Width="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource LiniaTabeli}"
                      Cursor="SizeWE"
                      ToolTip="Przeciągnij, aby zmienić szerokość listy zestawów." />

        <!-- Gdy nie wybrano rekordu, nie pokazuj pustej ściany bez wskazówki. -->
        <Border Grid.Column="2" Padding="28"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                MaxWidth="480">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Wybrany}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Wybierz zestaw z listy"
                           FontSize="19" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Tutaj zobaczysz szczegóły, zdjęcia własne i referencyjne, sloty oraz listę pakowania. Możesz też utworzyć nowy zestaw."
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"
                           Foreground="{Binding Drugorzedny, Source={x:Static app:App.Kolory}}" />
            </StackPanel>
        </Border>

        <!-- Karta zestawu (FR-701, FR-702, FR-703) -->
        <ScrollViewer x:Name="EdytorZestawu" Grid.Column="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding Wybrany, Converter={StaticResource KonwerterNieRowneNull}}">
            <StackPanel Margin="4" DataContext="{Binding Wybrany}">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Nazwa" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Column="1" Text="{Binding Zestaw.Nazwa}" />
                    <TextBlock Grid.Column="2" Text="Rekonstrukcja" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <ComboBox Grid.Column="3" Margin="8,0,0,0"
                              ItemsSource="{Binding DataContext.Rekonstrukcje, RelativeSource={RelativeSource AncestorType=Page}}"
                              SelectedValue="{Binding Zestaw.RekonstrukcjaId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Strona: " VerticalAlignment="Center" />
                    <ComboBox MinWidth="140"
                              ItemsSource="{Binding DataContext.Slowniki.Strony, RelativeSource={RelativeSource AncestorType=Page}}"
                              SelectedValue="{Binding Zestaw.StronaId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa" />
                    <CheckBox Content="Szkic" VerticalAlignment="Center" Margin="12,0,0,0"
                              IsChecked="{Binding Zestaw.CzySzkic}" />
                </StackPanel>

                <!-- Dwie odrębne galerie zestawu: dotychczasowe zdjęcia są galerią własnej sylwetki. -->
                <TextBlock Text="Moje zdjęcia w stroju" Style="{StaticResource NaglowekSekcji}"
                           Margin="0,14,0,4" />
                <TextBlock Text="Twoje rzeczywiste sylwetki i konfiguracje, bez limitu zdjęć."
                           Foreground="{Binding Drugorzedny, Source={x:Static app:App.Kolory}}"
                           TextWrapping="Wrap" Margin="0,0,0,5" />
                <controls:GaleriaZdjec Sciezki="{Binding Zestaw.Zdjecia}"
                                       Serwis="{Binding DataContext.SerwisZdjec, RelativeSource={RelativeSource AncestorType=Page}}"
                                       Opisy="{Binding Zestaw.OpisyZdjec}"
                                       WlascicielNazwa="{Binding Zestaw.Nazwa}"
                                       Zmieniono="GaleriaZdjec_Zmieniono" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                    <TextBlock Text="Zdjęcia referencyjne" Style="{StaticResource NaglowekSekcji}" />
                    <TextBlock Margin="10,4,0,0"
                               Foreground="{Binding Drugorzedny, Source={x:Static app:App.Kolory}}"
                               Text="{Binding DataContext.LicznikReferencji, RelativeSource={RelativeSource AncestorType=Page}, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Text="Zdjęcia wzorcowe do rekonstrukcji. Maksymalnie 10. Kliknij, aby powiększyć; prawy przycisk otwiera opis i usuwanie."
                           TextWrapping="Wrap"
                           Foreground="{Binding Drugorzedny, Source={x:Static app:App.Kolory}}"
                           Margin="0,0,0,5" />
                <controls:GaleriaZdjec Sciezki="{Binding Zestaw.ZdjeciaReferencyjne}"
                                       Serwis="{Binding DataContext.SerwisZdjec, RelativeSource={RelativeSource AncestorType=Page}}"
                                       Opisy="{Binding Zestaw.OpisyZdjec}"
                                       MaksymalnaLiczbaZdjec="10"
                                       WlascicielNazwa="{Binding Zestaw.Nazwa}"
                                       Zmieniono="GaleriaZdjec_Zmieniono" />

                <TextBlock Text="Sloty i warianty" Style="{StaticResource NaglowekSekcji}" Margin="0,16,0,4" />
                <ItemsControl ItemsSource="{Binding Zestaw.Sloty}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" Padding="6" Margin="0,2"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBox MinWidth="140" Text="{Binding Nazwa}" ToolTip="Nazwa slotu" />
                                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="Wariantów: " /><Run Text="{Binding Warianty.Count, Mode=OneWay}" />
                                        </TextBlock>
                                        <ui:Button Margin="8,0,0,0" Content="Dodaj wariant"
                                                   Command="{Binding DataContext.DodajWariantCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Margin="4,0,0,0" Appearance="Danger"
                                                   Command="{Binding DataContext.UsunSlotCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Dismiss24" />
                                        </ui:Button>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Warianty}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                        CornerRadius="4" Padding="6" Margin="0,2">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <RadioButton GroupName="Domyslny" Content="Domyślny"
                                                                         Checked="Domyslny_Checked">
                                                                <RadioButton.IsChecked>
                                                                    <MultiBinding Mode="OneWay" Converter="{x:Static conv:KonwerterRowneIdWariantu.Instance}">
                                                                        <Binding Path="Id" />
                                                                        <Binding Path="DataContext.WariantDomyslnyId" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                    </MultiBinding>
                                                                </RadioButton.IsChecked>
                                                            </RadioButton>
                                                            <CheckBox Content="Puste (celowo brak)" Margin="12,0,0,0"
                                                                      IsChecked="{Binding CzyPuste}" VerticalAlignment="Center" />
                                                            <ui:Button Margin="8,0,0,0" Content="Dodaj element"
                                                                       Command="{Binding DataContext.DodajElementCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                       CommandParameter="{Binding}" />
                                                            <ui:Button Margin="4,0,0,0" Appearance="Danger"
                                                                       Command="{Binding DataContext.UsunWariantCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                       CommandParameter="{Binding}">
                                                                <ui:SymbolIcon Symbol="Dismiss24" />
                                                            </ui:Button>
                                                        </StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Elementy}" Margin="0,4,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                        <ComboBox MinWidth="110" SelectedValue="{Binding Typ}">
                                                                            <ComboBoxItem Content="Przedmiot" Tag="0" />
                                                                            <ComboBoxItem Content="Replika" Tag="1" />
                                                                            <ComboBoxItem Content="Konfiguracja" Tag="3" ToolTip="Nazwana konfiguracja nośnika (FR-208)" />
                                                                        </ComboBox>
                                                                        <ComboBox MinWidth="220" Margin="8,0,0,0"
                                                                                  ItemsSource="{Binding DataContext.Przedmioty, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                  SelectedValue="{Binding ElementId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa" />
                                                                        <!-- Konfiguracje nośnika jako element wariantu (FR-208) -->
                                                                        <ComboBox MinWidth="220" Margin="8,0,0,0"
                                                                                  ItemsSource="{Binding DataContext.KonfiguracjeNosnikow, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                  SelectedValue="{Binding ElementId}" SelectedValuePath="Id" DisplayMemberPath="NazwaPelna"
                                                                                  Visibility="{Binding Typ, Converter={StaticResource KonwerterRowneTyp}, ConverterParameter=3}" />
                                                                        <ui:Button Margin="4,0,0,0" Appearance="Danger"
                                                                                   Command="{Binding DataContext.UsunElementCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                   CommandParameter="{Binding}">
                                                                            <ui:SymbolIcon Symbol="Dismiss24" />
                                                                        </ui:Button>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button Content="Dodaj slot" Margin="0,8,0,0"
                           Command="{Binding DataContext.DodajSlotCommand, RelativeSource={RelativeSource AncestorType=Page}}" />

                <!-- Lista pakowania (FR-707) + koszt zestawu (FR-708) -->
                <TextBlock Text="Lista pakowania (warianty domyślne)" Style="{StaticResource NaglowekSekcji}" Margin="0,16,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Koszt zestawu: " />
                        <Run Text="{Binding DataContext.KosztZestawu, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource KonwerterWaluty}}" />
                        <Run Text="{Binding DataContext.ZakresKosztu, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </TextBlock>
                    <ui:Button Content="Eksportuj listę (CSV)" Margin="16,0,0,0"
                               Command="{Binding DataContext.EksportujListePakowaniaCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding DataContext.GrupyPakowania, RelativeSource={RelativeSource AncestorType=Page}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Karta}" Padding="8" Margin="0,4">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding NazwaMiejsca}" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Postep, StringFormat=spakowane: {0}}" />
                                    <ItemsControl ItemsSource="{Binding Wiersze}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <CheckBox IsChecked="{Binding Spakowany, Mode=TwoWay}"
                                                              Checked="Spakowany_Changed" Unchecked="Spakowany_Changed" />
                                                    <TextBlock Text="{Binding Nazwa}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                    <TextBlock Text="{Binding NosnikNazwa, StringFormat={}(na: {0})}"
                                                               VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding NosnikNazwa, Converter={StaticResource KonwerterNieRowneNull}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <ui:Button Content="Zapisz" Appearance="Primary"
                               Command="{Binding DataContext.ZapiszKarteCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                    <ui:Button Content="Usuń zestaw" Appearance="Danger" Margin="8,0,0,0"
                               Command="{Binding DataContext.UsunCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               CommandParameter="{Binding}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <!-- Pasek komunikatu (wyniki eksportu) -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Komunikat}" VerticalAlignment="Center" Margin="0,4,0,0" />
    </Grid>
</Page>
