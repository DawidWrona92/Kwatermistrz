<UserControl x:Class="Kwatermistrz.App.Views.KartaPrzedmiotu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Kwatermistrz.App.Controls"
             xmlns:conv="clr-namespace:Kwatermistrz.App.Converters"
             xmlns:model="clr-namespace:Kwatermistrz.Core.Model;assembly=Kwatermistrz.Core">
    <UserControl.Resources>
        <conv:KonwerterNazwySlownika x:Key="KonwerterNazwySlownika" />
        <conv:KonwerterNazwSlownikaWiele x:Key="KonwerterNazwSlownikaWiele" />
        <conv:KonwerterWaluty x:Key="KonwerterWaluty" />
        <conv:KonwerterDaty x:Key="KonwerterDaty" />
        <conv:KonwerterRowne x:Key="KonwerterRowne" />
        <conv:KonwerterBoolToVisibility x:Key="KonwerterBoolToVisibility" />
        <ObjectDataProvider x:Key="Statusy" MethodName="GetValues" ObjectType="{x:Type sys:Enum}"
                            xmlns:sys="clr-namespace:System;assembly=System.Runtime">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:StatusWlasnosci" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <TextBlock Text="Karta przedmiotu" Style="{StaticResource NaglowekSekcji}" />

            <!-- Zdjęcia (FR-211): miniatury, powiększenie, zdjęcie główne -->
            <TextBlock Text="Zdjęcia" Style="{StaticResource NaglowekSekcji}" Margin="0,8,0,4" />
            <controls:GaleriaZdjec x:Name="Galeria"
                                   Sciezki="{Binding Przedmiot.Zdjecia}"
                                   Serwis="{Binding DataContext.DataContext.SerwisZdjec, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   WlascicielNazwa="{Binding Przedmiot.Nazwa}" />

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nazwa" VerticalAlignment="Center" />
                <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Przedmiot.Nazwa}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Firma" VerticalAlignment="Center" Margin="0,4,0,0" />
                <ui:TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Text="{Binding Przedmiot.Firma}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Kategoria" VerticalAlignment="Center" Margin="0,4,0,0" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                          ItemsSource="{Binding DataContext.DataContext.Slowniki.Kategorie, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedValue="{Binding Przedmiot.KategoriaId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Wzór" VerticalAlignment="Center" Margin="0,4,0,0" />
                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,0"
                          ItemsSource="{Binding DataContext.DataContext.Slowniki.Wzory, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedValue="{Binding Przedmiot.WzorId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Miejsce" VerticalAlignment="Center" Margin="0,4,0,0" />
                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4,0,0"
                          ItemsSource="{Binding DataContext.DataContext.Slowniki.Miejsca, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedValue="{Binding Przedmiot.MiejsceId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Pochodzenie" VerticalAlignment="Center" Margin="0,4,0,0" />
                <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,4,0,0"
                          ItemsSource="{Binding DataContext.DataContext.Slowniki.Pochodzenie, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedValue="{Binding Przedmiot.PochodzenieId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Status" VerticalAlignment="Center" Margin="0,4,0,0" />
                <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,4,0,0"
                          ItemsSource="{Binding Source={StaticResource Statusy}}"
                          SelectedItem="{Binding Przedmiot.Status}" />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Cena zakupu" VerticalAlignment="Center" Margin="0,4,0,0"
                           ToolTip="Tworzy pozycję kosztową „Zakup” (FR-503)" />
                <ui:TextBox Grid.Row="7" Grid.Column="1" Margin="0,4,0,0" Text="{Binding Przedmiot.CenaZakupu}" />

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Data zakupu" VerticalAlignment="Center" Margin="0,4,0,0" />
                <DatePicker Grid.Row="8" Grid.Column="1" Margin="0,4,0,0" SelectedDate="{Binding Przedmiot.DataZakupu}" />

                <TextBlock Grid.Row="9" Grid.Column="0" Text="Komentarz" VerticalAlignment="Top" Margin="0,8,0,0" />
                <ui:TextBox Grid.Row="9" Grid.Column="1" Margin="0,4,0,0" Text="{Binding Przedmiot.Komentarz}"
                            TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" />
            </Grid>

            <!-- Pozycje kosztowe (FR-501, FR-503) -->
            <TextBlock Text="Pozycje kosztowe" Style="{StaticResource NaglowekSekcji}" Margin="0,16,0,4" />
            <ItemsControl ItemsSource="{Binding Przedmiot.Koszty}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Data, Converter={StaticResource KonwerterDaty}}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Opis}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Text="{Binding Kwota, Converter={StaticResource KonwerterWaluty}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Brak pozycji — cena zakupu tworzy pierwszą przy zapisie karty (FR-503)."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"
                       Visibility="{Binding Przedmiot.Koszty.Count, Converter={x:Static conv:KonwerterRowneLiczbe.Instance}, ConverterParameter=0}" />

            <!-- Komplet (FR-206) -->
            <TextBlock Text="Komplet" Style="{StaticResource NaglowekSekcji}" Margin="0,16,0,4" />
            <TextBlock Visibility="{Binding CzyWKomplecie, Converter={x:Static conv:KonwerterNieRowneNull.Instance}}"
                       Text="Element kompletu" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <ui:Button Content="Dołącz do kompletu…" Command="{Binding DataContext.DataContext.DolaczDoKompletuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           CommandParameter="{Binding DataContext.DataContext.Wybrany, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <ui:Button Content="Odepnij od kompletu" Margin="8,0,0,0"
                           Command="{Binding DataContext.DataContext.OdlaczZKompletuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>

            <!-- Montaż (FR-207) -->
            <TextBlock Text="Montaż na nośniku" Style="{StaticResource NaglowekSekcji}" Margin="0,16,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <ComboBox MinWidth="180" ItemsSource="{Binding DataContext.DataContext.Nosniki, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedValue="{Binding Przedmiot.ZamontowanyNaId}" SelectedValuePath="Id" DisplayMemberPath="Nazwa"
                          ToolTip="Nośnik (puste = niezamontowany)" />
                <ui:Button Content="Zdejmij" Margin="8,0,0,0"
                           Command="{Binding DataContext.DataContext.ZdejmijCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>

            <!-- Konfiguracje nośnika (FR-208) — tylko gdy przedmiot jest nośnikiem -->
            <StackPanel Visibility="{Binding CzyNosnik, Converter={StaticResource KonwerterBoolToVisibility}}">
                <TextBlock Text="Konfiguracje nośnika" Style="{StaticResource NaglowekSekcji}" Margin="0,16,0,4"
                           ToolTip="Nazwane konfiguracje (np. „Skanda Light”) — listy elementów; można ich użyć jako wariantu w zestawie (FR-208)" />
                <ItemsControl ItemsSource="{Binding Przedmiot.Konfiguracje}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" Padding="4" Margin="0,2"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" Text="{Binding Nazwa}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding ElementyId.Count, StringFormat={}{0} elem.}" />
                                    <ui:Button Grid.Column="2" Content="Zastosuj" Margin="4,0,0,0" Padding="6,2"
                                               Command="{Binding DataContext.DataContext.DataContext.ZastosujKonfiguracjeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Grid.Column="3" Margin="4,0,0,0" Padding="6,2" Appearance="Danger"
                                               Command="{Binding DataContext.DataContext.DataContext.UsunKonfiguracjeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss24" />
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <ui:Button Content="Zapisz z zamontowanych" Padding="6,2"
                               Command="{Binding DataContext.DataContext.ZapiszKonfiguracjeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               ToolTip="Tworzy konfigurację z elementów aktualnie zamontowanych na tym nośniku" />
                    <ui:Button Content="Dodaj pustą" Margin="8,0,0,0" Padding="6,2"
                               Command="{Binding DataContext.DataContext.DodajKonfiguracjeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <ui:Button Content="Zapisz" Appearance="Primary"
                           Command="{Binding DataContext.DataContext.ZapiszKarteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <ui:Button Content="Duplikuj" Margin="8,0,0,0"
                           Command="{Binding DataContext.DataContext.DuplikujCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <ui:Button Content="Usuń" Appearance="Danger" Margin="8,0,0,0"
                           Command="{Binding DataContext.DataContext.UsunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           CommandParameter="{Binding}" />
                <!-- FR-1205: ostatnia zmiana na karcie -->
                <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding Przedmiot.OstatniaZmiana, StringFormat=Ostatnia zmiana: {0:dd.MM.yyyy HH:mm}}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
