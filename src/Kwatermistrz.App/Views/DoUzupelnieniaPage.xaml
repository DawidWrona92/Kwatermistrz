<Page x:Class="Kwatermistrz.App.Views.DoUzupelnieniaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Do uzupełnienia">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Do uzupełnienia" Style="{StaticResource TytulEkranu}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock VerticalAlignment="Center" Opacity="0.7">
                <Run Text="Pozycji: " /><Run Text="{Binding Liczba, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
        <ui:DataGrid Grid.Row="1"
                     ItemsSource="{Binding Pozycje}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Rodzaj" Binding="{Binding Rodzaj}" Width="180" />
                <DataGridTextColumn Header="Opis" Binding="{Binding Opis}" Width="*" />
                <DataGridTemplateColumn Header="Akcja" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Content="Przejrzyj i potwierdź" Appearance="Primary"
                                       Command="{Binding DataContext.PotwierdzCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</Page>
