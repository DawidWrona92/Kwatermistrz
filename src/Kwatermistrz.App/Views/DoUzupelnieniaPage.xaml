<Page x:Class="Kwatermistrz.App.Views.DoUzupelnieniaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Do uzupełnienia">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Do uzupełnienia" Style="{StaticResource TytulEkranu}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="Pozycji: " /><Run Text="{Binding Liczba, Mode=OneWay}" />
            </TextBlock>
            <CheckBox Content="Tylko zadania" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding TylkoZadania}" />
        </StackPanel>
        <ui:DataGrid Grid.Row="1"
                     ItemsSource="{Binding Pozycje}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Rodzaj" Binding="{Binding Rodzaj}" Width="180" />
                <DataGridTextColumn Header="Opis" Binding="{Binding Opis}" Width="*" />
                <DataGridTemplateColumn Header="Akcje" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Otwórz" Appearance="Primary" Margin="0,0,6,0"
                                           IsEnabled="{Binding MoznaOtworzyc}"
                                           Command="{Binding DataContext.PrzejrzyjCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Content="Potwierdź" ToolTip="Potwierdź po sprawdzeniu danych"
                                           IsEnabled="{Binding MoznaPotwierdzic}"
                                           Command="{Binding DataContext.PotwierdzCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</Page>
