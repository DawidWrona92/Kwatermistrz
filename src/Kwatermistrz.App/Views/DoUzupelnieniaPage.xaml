<Page x:Class="Kwatermistrz.App.Views.DoUzupelnieniaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Kwatermistrz.App.Controls"
      Title="Do uzupełnienia" TextElement.Foreground="{DynamicResource TekstAplikacji}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Do uzupełnienia" Style="{StaticResource TytulEkranu}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="Pozycji: " /><Run Text="{Binding Liczba, Mode=OneWay}" />
            </TextBlock>
            <CheckBox Content="Tylko zadania" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding TylkoZadania}" />
        </StackPanel>
        <ui:DataGrid Grid.Row="1"
                     ItemsSource="{Binding Pozycje}"
                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     HeadersVisibility="Column" GridLinesVisibility="All"
                         HorizontalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         VerticalGridLinesBrush="{DynamicResource LiniaTabeli}"
                         BorderBrush="{DynamicResource LiniaTabeli}" BorderThickness="1"
                         AlternationCount="2"
                         AlternatingRowBackground="{DynamicResource WierszTabeliNaprzemienny}"
                         CanUserResizeColumns="True" ColumnWidth="*"
                         HorizontalScrollBarVisibility="Auto" controls:ProporcjonalneKolumny.Wlaczone="True">
            <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Rodzaj" Binding="{Binding Rodzaj}" Width="1.25*" MinWidth="90" />
                <DataGridTextColumn ElementStyle="{StaticResource WierszTabeliTekst}" Header="Opis" Binding="{Binding Opis}" Width="2.5*" MinWidth="145" />
                <DataGridTemplateColumn Header="Akcja" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Content="Przejrzyj i potwierdź" Appearance="Primary"
                                       Command="{Binding DataContext.PotwierdzCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</Page>
