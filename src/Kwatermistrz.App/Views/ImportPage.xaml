<Page x:Class="Kwatermistrz.App.Views.ImportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:Kwatermistrz.App.Converters"
      Title="Import">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Import z arkusza" Style="{StaticResource TytulEkranu}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
            <ui:Button Content="Wybierz plik .xlsx…" Appearance="Primary"
                       Command="{Binding WybierzPlikCommand}" />
            <TextBlock Text="{Binding Sciezka}" VerticalAlignment="Center" Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis" MaxWidth="500" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Planowane rekordy" Style="{StaticResource NaglowekSekcji}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding LiczbaRekordow}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Nazwa}" />
                                <TextBlock Grid.Column="1" Text="{Binding Liczba}" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Pozycje do rozstrzygnięcia" Style="{StaticResource NaglowekSekcji}" Margin="0,0,0,8" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                    <ItemsControl ItemsSource="{Binding Konflikty}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" Padding="6" Margin="0,2"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Opis}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Zrodlo}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                                        <ComboBox ItemsSource="{Binding Kandydaci}"
                                                  SelectedIndex="{Binding WyborUzytkownika}"
                                                  Visibility="{Binding Kandydaci.Count, Converter={x:Static conv:KonwerterWiekszeOdZera.Instance}}"
                                                  Margin="0,4,0,0" />
                                        <CheckBox Content="Pomiń" IsChecked="{Binding Pomin}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button Content="Zastosuj import" Appearance="Primary"
                       Command="{Binding ZastosujCommand}" />
            <TextBlock Text="{Binding Komunikat}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
    </Grid>
</Page>
