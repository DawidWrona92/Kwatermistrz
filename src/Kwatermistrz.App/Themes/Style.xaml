<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Typografia (§10.3): jedna rodzina Bahnschrift z zapasową Segoe UI. -->
    <FontFamily x:Key="CzcionkaBazowa">Bahnschrift, Segoe UI</FontFamily>

    <!-- Tytuł ekranu: Bahnschrift SemiCondensed SemiBold 22 px -->
    <Style x:Key="TytulEkranu" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CzcionkaBazowa}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontStretch" Value="SemiCondensed" />
    </Style>

    <!-- Nagłówek sekcji: 16 px SemiBold -->
    <Style x:Key="NaglowekSekcji" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CzcionkaBazowa}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontStretch" Value="SemiCondensed" />
    </Style>

    <!-- Liczby na pulpicie: 32 px Bold -->
    <Style x:Key="LiczbaPulpitu" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CzcionkaBazowa}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="SemiCondensed" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- Data na pulpicie (mniejsza liczba) -->
    <Style x:Key="LiczbaPulpituMniejsza" TargetType="TextBlock" BasedOn="{StaticResource LiczbaPulpitu}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Etykieta liczby na pulpicie -->
    <Style x:Key="EtykietaLiczby" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CzcionkaBazowa}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <!-- Karta liczby na pulpicie -->
    <Style x:Key="KartaLiczby" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="MinWidth" Value="150" />
    </Style>

    <!-- Karta ogólna (panele, sekcje) -->
    <Style x:Key="Karta" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

</ResourceDictionary>
