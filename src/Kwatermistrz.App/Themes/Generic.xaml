<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Kwatermistrz.App.Controls">

    <!-- Domyślny styl próbki kamuflażu: kontener, siatkę kolorów rysuje kod kontrolki (§10.5). -->
    <Style TargetType="{x:Type controls:ProbkaKamuflazu}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Domyślny styl mozaiki wypraw: kontrolka sama buduje wiersze kafelków (FR-102). -->
    <Style TargetType="{x:Type controls:MozaikaWypraw}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Wykresy (FR-909): rysowane w OnRender, bez szablonu. -->
    <Style TargetType="{x:Type controls:WykresPionowy}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MinHeight" Value="140" />
    </Style>
    <Style TargetType="{x:Type controls:WykresPoziomy}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
